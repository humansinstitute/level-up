{
  "name": "level-up-wapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bun run src/server.ts",
    "build": "vite build",
    "build:verify": "vite build --outDir .validation-dist",
    "test": "bun test src --max-concurrency=1",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build:verify && bun scripts/check-performance-budget.ts",
    "test:feedback:preflight": "bun scripts/feedback-preflight.ts && bun scripts/feedback-preflight.ts --tool-probe && bun scripts/feedback-preflight.ts --timeout-probe && bun scripts/feedback-preflight.ts --cancel-probe",
    "test:feedback:browser": "bun scripts/feedback-browser-smoke.ts",
    "test:e2e:v2": "bun run build:verify && bun scripts/v2-playwright-acceptance.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.16.0",
    "dexie": "^4.4.5",
    "nostr-tools": "^2.17.2",
    "playwright": "1.51.1",
    "qrcode": "^1.5.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "latest",
    "vite": "^7.1.3"
  }
}
