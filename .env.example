# Verified Nostr signatures are accepted by default. Set restricted to enforce
# the owner/additional allowlist below.
WAPP_ACCESS_MODE=open
WAPP_OWNER_NPUB=npub1...
WAPP_ALLOWED_NPUBS_JSON=["npub1..."]

# Runtime settings.
PORT=3000
LOGIN_CHALLENGE_TTL_SECONDS=90
SESSION_TTL_SECONDS=28800

# Temporary local spike persistence. Mount this directory durably in containers.
LEVELUP_DATABASE_PATH=runtime-data/levelup.sqlite
TEMPLATE_SELECTION_SECONDS=176
ROUND_BRAINSTORM_SECONDS=300

# lvl_up agent runtime. Server-only; Pete enters the key in the owner app card.
# When the key, model, and Goose binary are configured, Level Up uses the agent
# automatically for brainstorm suggestions, proposals, and feedback synthesis.
OPENROUTER_API_KEY=
LEVELUP_AGENT_MODEL=
LEVELUP_GOOSE_BIN=/path/to/goose
LEVELUP_AGENT_TIMEOUT_SECONDS=120
LEVELUP_AGENT_MAX_OUTPUT_TOKENS=2000
LEVELUP_BUILD_MAX_OUTPUT_TOKENS=32768
LEVELUP_AGENT_MAX_INPUT_BYTES=65536
LEVELUP_AGENT_CONCURRENCY=1
